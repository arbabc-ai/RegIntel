# Provider routing — set ONE path. Bedrock (recommended) takes precedence when both are present.
BEDROCK_INFERENCE_PROFILE=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION=us-east-1
# Anthropic SDK fallback (only used if BEDROCK_INFERENCE_PROFILE is unset):
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

CHROMA_DB_PATH=./data/chroma

# Embeddings: leave USE_BEDROCK_EMBEDDINGS unset for free/offline local MiniLM,
# or set =1 to use Amazon Titan on Bedrock (the in-stack production choice).
# USE_BEDROCK_EMBEDDINGS=1
TITAN_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
